{
  "name": "erp-it-test",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "pnpm -r --parallel --filter @erp/shared --filter api --filter web dev",
    "dev:api": "pnpm --filter api start:dev",
    "dev:web": "pnpm --filter web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter api test:e2e",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter api prisma:migrate",
    "db:generate": "pnpm --filter api prisma:generate",
    "db:studio": "pnpm --filter api prisma:studio",
    "db:seed": "pnpm --filter api seed",
    "db:reset": "pnpm --filter api db:reset",
    "prototype": "node erp-prototype-html/scripts/serve.mjs",
    "prototype:check": "node erp-prototype-html/scripts/check-links.mjs"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
